# Sync daemon container.
# Polls the database for enabled users and runs extractors on schedule.
#
# Build:  docker build -t m365-daemon:latest -f Dockerfile.daemon .
# Run:    docker run --env-file .env m365-daemon:latest

FROM python:3.12-slim AS builder

WORKDIR /build

COPY pyproject.toml README.md ./
COPY m365_extract/ m365_extract/
COPY m365_admin/ m365_admin/
RUN pip install --no-cache-dir ".[admin,azure]"

# --- Runtime stage ---
FROM python:3.12-slim

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin/m365-extract /usr/local/bin/m365-extract

COPY m365_extract/ m365_extract/
COPY m365_admin/ m365_admin/
COPY config/ config/
COPY alembic.ini .
COPY alembic/ alembic/
COPY scripts/daemon_healthcheck.py scripts/daemon_healthcheck.py

RUN useradd --create-home appuser && \
    mkdir -p /app/state /app/vault && \
    chown -R appuser:appuser /app/state /app/vault

USER appuser

ENV PYTHONPATH=/app

HEALTHCHECK --interval=60s --timeout=5s --retries=3 \
    CMD python scripts/daemon_healthcheck.py

ENTRYPOINT ["m365-extract", "--config", "config/base.yaml,config/auth.yaml,config/storage/azure_blob.yaml,config/service/web.yaml,config/env/dev.yaml", "daemon"]

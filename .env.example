# m365-brain environment variables
# Copy to .env and fill in values. All ${VAR} references in config files expand from here.

# --- CLI mode (device code auth) ---
MSAL_CLIENT_ID=your-entra-app-client-id
MSAL_TENANT_ID=your-entra-tenant-id

# --- Web / Admin UI mode ---
# Entra app registration (auth code flow with client secret)
AZURE_CLIENT_ID=your-entra-app-client-id
AZURE_TENANT_ID=your-entra-tenant-id
AZURE_CLIENT_SECRET=your-entra-client-secret

# App secrets (generate once, keep stable)
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-with-python-secrets
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=generate-with-cryptography-fernet

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///state/web.db

# OAuth redirect (must match Entra app registration)
M365_ADMIN_REDIRECT_URI=http://localhost:3000/callback

# Config file for web mode
M365_ADMIN_CONFIG=./config.web.yaml

# Admin users (comma-separated emails with admin role in the UI)
ADMIN_EMAIL=your-email@example.com

# --- Azure Storage (set by deploy-infra.sh or manually for Azure backend) ---
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
# AZURE_STORAGE_CONTAINER=m365-vaults
# AZURE_STORAGE_PREFIX=dev/
